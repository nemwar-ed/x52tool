# x52tool – English language file
# Encoding: UTF-8
# Placeholders: {name} is substituted at runtime via .format()

[main]
window_title         = x52tool {version}
label_device         = Device
btn_rescan           = Rescan
tab_device           = Device
tab_live             = Live Test
tab_analysis         = Analysis
tab_calib            = Calibration
tab_calib2           = Axes & Calibration
tab_output           = LED / MFD
status_no_device     = No device
status_device        = {name} – {axes} axes, {buttons} buttons

[device]
col_property         = Property
col_value            = Value
tree_label           = Event nodes of the same USB device
tree_col_node        = Node
tree_col_role        = Role
tree_col_evtypes     = Event types
tree_used_label      = Joystick axes (in use)
note_no_device       = No joystick-like input device found. Is the stick plugged in and does `lsusb` list it?
note_multi_node      = This stick exposes multiple event nodes – expanded above. Only the one marked "in use" provides the axes and buttons in this program; the others (e.g. a mouse emulation for the ministick) are not evaluated here.
note_single_node     = No additional event node found with the same USB-ID – either the stick only exposes one, or an extra node exists but is not readable (see below).
note_unknown_id      = The USB-ID is not in the known list. The tool still works, but LED and MFD output will be unavailable.
note_readonly        = {path} is read-only. Calibration requires write access – the Calibration tab can generate a ready-made udev rule for this.
note_denied          = Skipped (no read access): {paths}
note_errors          = Errors while opening (not a permission or format issue, see text):\n{errors}
describe_name        = Name
describe_path        = Path
describe_usb_id      = USB-ID
describe_known_as    = Recognised as
describe_unknown     = unknown input device
describe_mfd_leds    = MFD / LEDs
describe_mfd_yes     = yes (Pro)
describe_mfd_no      = no
describe_phys_path   = Physical path
describe_serial      = Serial number
describe_version     = Version
describe_axes        = Axes
describe_buttons     = Buttons
describe_writable    = Write access
describe_yes         = yes
describe_no          = no
role_mouse_emu       = Mouse emulation (probably ministick)
role_joystick        = Joystick axes (this node is in use)
role_extra_axes      = Extra axes without main stick
role_buttons_only    = Buttons only, no axes
role_unclear         = Unclear role
role_virtual_suffix  =  – virtual, matched by name (no USB-ID present)

[live]
hint_no_device       = No device selected.
hint_active          = Move everything, press every button once. Any bar or field that does not respond, or any button that does not light up, is your finding.
group_axes           = Axes
group_ministick      = Ministick
group_extra_axes     = Extra axes
group_hats           = Hats
group_buttons        = Buttons
group_toggles        = Toggles
group_mode           = Mode
group_mfd            = MFD
ministick_label      = Mouse stick
dir_up               = Up
dir_down             = Down
dir_left             = Left
dir_right            = Right
rocker_up            = Up
rocker_down          = Down
rocker_click         = Click
mfd_left             = Left
mfd_right            = Right

[calib]
status_no_device     = No device selected.
status_rw            = Changes take effect immediately and persist until the stick is unplugged. For permanent changes: generate a udev rule below.
status_ro            = Read-only access to {path}. Writes will fail. Use "Generate rights rule" to create a udev rule that grants write access to exactly this device.
col_axis             = Axis
col_minimum          = Minimum
col_maximum          = Maximum
col_fuzz             = Fuzz
col_deadzone         = Deadzone (flat)
col_deadzone_pct     = Deadzone %
tooltip_fuzz         = Fuzz: the kernel ignores any value change smaller than this amount, regardless of where the axis currently is. A pure noise filter, effective everywhere.
tooltip_deadzone     = Deadzone (also called "flat"): a window around the axis centre (minimum+maximum)/2 in which movement is ignored. Only useful for axes with spring return – otherwise the window may be in the wrong place.
btn_reload           = Read from device
btn_apply            = Write to device
btn_reset            = Reset to kernel defaults
btn_save             = Save as profile
btn_load             = Load profile
btn_udev             = Generate udev rule
btn_rights           = Generate rights rule
dlg_write_fail_title = Write failed
dlg_write_fail_msg   = No write access to {path}.\n\nGenerate a rights rule below, or run the program once with elevated privileges to test the effect.
dlg_reset_fail_title = Reset failed
dlg_profile_saved_title = Profile saved
dlg_profile_saved_msg   = Stored at {path}
dlg_no_profile_title = No profile
dlg_no_profile_msg   = Nothing stored for {usb_id}.
dlg_udev_title       = udev rule
dlg_rights_title     = Rights rule
dlg_close            = Close

[analysis]
explain = Rest measurement: hands off, don't touch anything. For stick and twist (true spring return) a deadzone suggestion around the centre. For throttle, sliders and Rotary 1/2 (no spring return, sometimes no fixed centre) a fuzz suggestion instead – effective regardless of position.\nRange measurement: move each axis slowly from stop to stop. Shows whether the pots still reach their full range.\n\nDeadzone (also "flat"): a window around the axis centre in which small movements are ignored. Only useful for axes with spring return.\nFuzz: the kernel ignores any value change smaller than this amount – a pure noise filter, position-independent.
label_duration       = Duration
checkbox_zero_fuzz   = set fuzz to 0 during measurement
tooltip_zero_fuzz    = The kernel suppresses changes smaller than fuzz. Without this step you measure the filter, not the hardware. Restored afterwards.
btn_rest             = Start rest measurement
btn_range            = Start range measurement
btn_stop             = Cancel
btn_apply            = Apply suggestions to Calibration
btn_toggle_show_range = Show range measurement
btn_toggle_show_rest  = Show rest measurement
group_guided         = Guided measurement (one axis at a time)
guided_explain       = Instead of moving all axes at once: select one axis (or all in sequence) and the tool guides you through rest and range measurement for each individually.
label_axis           = Axis
all_axes_item        = All axes (in sequence)
btn_guided_start     = Start guided
guided_instruction_rest  = Axis {pos} of {total}: {label}\nLet go, don't touch – rest measurement running.
guided_instruction_range = Axis {pos} of {total}: {label}\nNow move SLOWLY from stop to stop.
guided_aborted       = Aborted.
guided_done          = Guided measurement complete ({count} axis/axes).
rest_col_axis        = Axis
rest_col_offset      = Centre offset
rest_col_noise       = Noise (peak-to-peak)
rest_col_stddev      = Std dev
rest_col_current     = Current (deadzone / fuzz)
rest_col_suggestion  = Suggestion
rest_tooltip_current = Deadzone/flat: window around the centre in which movement is ignored – only useful for axes with spring return.\nFuzz: ignores any value change below this amount, wherever the axis is – a pure noise filter.
rest_tooltip_suggestion = For axes with a fixed centre: deadzone suggestion.\nFor all others: fuzz suggestion (see column left).
rest_no_center       = –  (no fixed centre)
rest_suggestion_deadzone = {value}  (deadzone)
rest_suggestion_fuzz     = {value}  (fuzz)
range_col_axis       = Axis
range_col_min        = Min reached
range_col_max        = Max reached
range_col_kernel     = Kernel range
range_col_coverage   = Coverage
range_col_verdict    = Verdict
range_verdict_full   = full travel
range_verdict_ok     = close, but usable
range_verdict_low    = does not reach the stops
range_verdict_bad    = barely moved or defective

[output]
status_available     = Output via {binary}. If the x52d daemon is running, its client should be listed here – two processes writing to MFD and LEDs simultaneously will confuse the device.
status_unavailable   = No libx52 CLI found. The X52 Pro's LEDs and MFD are controlled via USB control transfers, not evdev – libx52 is required. Use "Find program" below or enter the path manually.
group_leds           = LEDs
btn_sweep            = Test all LEDs
btn_all_on           = All on
btn_all_off          = All off
label_brightness     = Brightness
group_mfd            = MFD ({lines} lines of {width} characters)
mfd_row_label        = Line {line}
btn_mfd_test         = Send test pattern
btn_mfd_clear        = Clear MFD
group_clutch         = Clutch (button 31, symbol: circled "i")
clutch_explain       = When clutch mode is active on the device, the kernel driver (usbhid) no longer reads this button as a normal joystick button – it becomes invisible in the Live Test even when physically pressed. Disable it here if the installed libx52 version supports it.
clutch_checkbox      = Clutch mode active
group_backend        = libx52 CLI invocation
backend_label_binary = Program
backend_label_led    = LED
backend_label_mfd    = MFD
backend_label_bri    = Brightness
backend_label_clutch = Clutch
backend_hint         = Placeholders: {bin} {led} {state} {line} {text} {target} {value}. The template is tokenised first, then substituted – MFD text with spaces stays a single argument.
btn_detect           = Find program
btn_save_backend     = Apply and save
group_log            = Log
log_settings_saved   = Settings saved to {path}
log_no_binary        = No x52ctl or x52cli in PATH. Install libx52 (PPA, AUR or from source).
log_summary          = -- {count} commands, {failures} failed
led_fire             = Fire (cover)
led_a                = Button A
led_b                = Button B
led_d                = Button D
led_e                = Button E
led_t1               = Toggle T1/T2
led_t2               = Toggle T3/T4
led_t3               = Toggle T5/T6
led_pov              = POV hat 2
led_clutch           = Clutch (i-button)
led_throttle         = Throttle

[settings]
tab_label            = Settings
group_language       = Language
btn_de               = German
btn_en               = English
