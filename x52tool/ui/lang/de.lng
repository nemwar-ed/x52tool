# x52tool – Deutsche Sprachdatei
# Encoding: UTF-8
# Platzhalter: {name} wird zur Laufzeit durch .format() ersetzt.

[main]
window_title         = x52tool {version}
label_device         = Gerät
btn_rescan           = Neu suchen
tab_device           = Gerät
tab_live             = Live-Test
tab_analysis         = Analyse
tab_calib            = Kalibrierung
tab_calib2           = Achsen & Kalibrierung
tab_output           = LED / MFD
status_no_device     = Kein Gerät
status_device        = {name} – {axes} Achsen, {buttons} Tasten

[device]
col_property         = Eigenschaft
col_value            = Wert
tree_label           = Event-Knoten desselben USB-Geräts
tree_col_node        = Knoten
tree_col_role        = Rolle
tree_col_evtypes     = Event-Typen
tree_used_label      = Joystick-Achsen (verwendet)
note_no_device       = Kein joystickartiges Eingabegerät gefunden. Steckt der Stick, und zeigt `lsusb` ihn an?
note_multi_node      = Derselbe Stick meldet mehrere Event-Knoten – oben aufgeklappt. Nur der als „verwendet" markierte liefert die Achsen und Tasten in diesem Programm; die anderen (z.B. eine Maus-Emulation für den Ministick) werden hier nicht ausgewertet.
note_single_node     = Kein weiterer Event-Knoten mit derselben USB-ID gefunden – entweder meldet der Stick nur einen, oder ein zusätzlicher Knoten liegt ohne Leserecht vor (siehe unten).
note_unknown_id      = Die USB-ID steht nicht in der bekannten Liste. Das Werkzeug funktioniert trotzdem, nur LED und MFD bleiben aus.
note_readonly        = Auf {path} besteht nur Leserecht. Kalibrieren braucht Schreibrecht – im Reiter Kalibrierung gibt es dafür eine fertige udev-Regel.
note_denied          = Ohne Leserecht übersprungen: {paths}
note_errors          = Fehler beim Öffnen (weder Rechte- noch Formatproblem, siehe Text):\n{errors}
describe_name        = Name
describe_path        = Pfad
describe_usb_id      = USB-ID
describe_known_as    = Erkannt als
describe_unknown     = unbekanntes Eingabegerät
describe_mfd_leds    = MFD / LEDs
describe_mfd_yes     = ja (Pro)
describe_mfd_no      = nein
describe_phys_path   = Physischer Pfad
describe_serial      = Seriennummer
describe_version     = Version
describe_axes        = Achsen
describe_buttons     = Tasten
describe_writable    = Schreibrecht
describe_yes         = ja
describe_no          = nein
role_mouse_emu       = Maus-Emulation (vermutlich Ministick)
role_joystick        = Joystick-Achsen (dieser Knoten wird verwendet)
role_extra_axes      = Zusatzachsen ohne Haupt-Stick
role_buttons_only    = Nur Tasten, keine Achsen
role_unclear         = Unklare Rolle
role_virtual_suffix  =  – virtuell, per Name erkannt (keine USB-ID vorhanden)

[live]
hint_no_device       = Kein Gerät gewählt.
hint_active          = Alles bewegen, jede Taste einmal drücken. Ein Feld/Balken, das sich nicht bewegt, oder eine Taste, die nicht aufleuchtet, ist der Befund.
group_axes           = Achsen
group_ministick      = Ministick
group_extra_axes     = Weitere Achsen
group_hats           = Hats
group_buttons        = Buttons
group_toggles        = Toggles
group_mode           = Mode
group_mfd            = MFD
ministick_label      = Maus-Stick
dir_up               = Hoch
dir_down             = Runter
dir_left             = Links
dir_right            = Rechts
rocker_up            = Hoch
rocker_down          = Runter
rocker_click         = Klick
mfd_left             = Links
mfd_right            = Rechts

[calib]
status_no_device     = Kein Gerät gewählt.
status_rw            = Änderungen wirken sofort und gelten bis zum Abziehen des Sticks. Für dauerhaft: unten eine udev-Regel erzeugen.
status_ro            = Nur Lesezugriff auf {path}. Schreiben schlägt fehl. Mit „Rechte-Regel erzeugen" bekommst du eine udev-Regel, die genau diesem Gerät Schreibrecht gibt.
col_axis             = Achse
col_minimum          = Minimum
col_maximum          = Maximum
col_fuzz             = Fuzz
col_deadzone         = Deadzone (flat)
col_deadzone_pct     = Deadzone %
tooltip_fuzz         = Fuzz: der Kernel ignoriert jede Wertänderung, die kleiner ist als dieser Betrag – unabhängig davon, wo die Achse gerade steht. Ein reiner Rauschfilter, wirkt überall.
tooltip_deadzone     = Deadzone (auch „flat" genannt): ein Fenster um die Achsenmitte (Minimum+Maximum)/2, in dem Bewegungen ignoriert werden. Nur sinnvoll bei Achsen, die von selbst zur Mitte zurückfedern – sonst kann das Fenster an der falschen Stelle liegen.
btn_reload           = Vom Gerät lesen
btn_apply            = Auf Gerät schreiben
btn_reset            = Auf Kernel-Standard zurück
btn_save             = Als Profil speichern
btn_load             = Profil laden
btn_udev             = udev-Regel erzeugen
btn_rights           = Rechte-Regel erzeugen
dlg_write_fail_title = Schreiben fehlgeschlagen
dlg_write_fail_msg   = Kein Schreibrecht auf {path}.\n\nErzeuge unten eine Rechte-Regel oder starte das Programm einmal mit erhöhten Rechten, um den Effekt zu testen.
dlg_reset_fail_title = Zurücksetzen fehlgeschlagen
dlg_profile_saved_title = Profil gespeichert
dlg_profile_saved_msg   = Abgelegt in {path}
dlg_no_profile_title = Kein Profil
dlg_no_profile_msg   = Für {usb_id} ist nichts gespeichert.
dlg_udev_title       = udev-Regel
dlg_rights_title     = Rechte-Regel
dlg_close            = Schließen

[analysis]
explain = Ruhemessung: Hände weg, nichts anfassen. Für Stick und Twist (echte Federrückstellung) ein Deadzone-Vorschlag um die Mitte. Für Schubhebel, Schieberegler und Rotary 1/2 (keine Federrückstellung, teils auch keine feste Mitte) stattdessen ein Fuzz-Vorschlag – der wirkt unabhängig von der Position.\nBereichsmessung: jede Achse einmal langsam von Anschlag zu Anschlag. Zeigt, ob die Potis den vollen Bereich noch erreichen.\n\nDeadzone (auch „flat" genannt): ein Fenster um die Achsenmitte, in dem kleine Bewegungen ignoriert werden. Nur sinnvoll bei Achsen, die von selbst zur Mitte zurückfedern.\nFuzz: der Kernel ignoriert jede Wertänderung, die kleiner ist als dieser Betrag – ein reiner Rauschfilter, unabhängig davon, wo die Achse gerade steht.
label_duration       = Dauer
checkbox_zero_fuzz   = fuzz während der Messung auf 0 setzen
tooltip_zero_fuzz    = Der Kernel unterdrückt Änderungen kleiner als fuzz. Ohne diesen Schritt misst man das Filter statt der Hardware. Wird danach wiederhergestellt.
btn_rest             = Ruhemessung starten
btn_range            = Bereichsmessung starten
btn_stop             = Abbrechen
btn_apply            = Vorschläge in Kalibrierung übernehmen
btn_toggle_show_range = Bereichsmessung anzeigen
btn_toggle_show_rest  = Ruhemessung anzeigen
group_guided         = Geführte Messung (eine Achse nach der anderen)
guided_explain       = Statt alle Achsen gleichzeitig durcheinanderzubewegen: eine Achse auswählen (oder alle der Reihe nach), das Tool führt dich durch Ruhe- und Bereichsmessung für jede einzeln.
label_axis           = Achse
all_axes_item        = Alle Achsen (der Reihe nach)
btn_guided_start     = Geführt starten
guided_instruction_rest  = Achse {pos} von {total}: {label}\nJetzt loslassen, nichts anfassen – Ruhemessung läuft.
guided_instruction_range = Achse {pos} von {total}: {label}\nJetzt einmal LANGSAM von Anschlag zu Anschlag bewegen.
guided_aborted       = Abgebrochen.
guided_done          = Geführte Messung abgeschlossen ({count} Achse(n)).
rest_col_axis        = Achse
rest_col_offset      = Mittenversatz
rest_col_noise       = Rauschen (Spitze-Spitze)
rest_col_stddev      = Standardabw.
rest_col_current     = Aktuell (Deadzone / Fuzz)
rest_col_suggestion  = Vorschlag
rest_tooltip_current = Deadzone/flat: Fenster um die Mitte, in dem Bewegungen ignoriert werden – nur sinnvoll bei Achsen mit Federrückstellung.\nFuzz: ignoriert jede Wertänderung unterhalb dieses Betrags, egal wo die Achse steht – ein reiner Rauschfilter.
rest_tooltip_suggestion = Bei Achsen mit fester Mitte: Deadzone-Vorschlag.\nBei allen anderen: Fuzz-Vorschlag (siehe Spalte links).
rest_no_center       = –  (keine feste Mitte)
rest_suggestion_deadzone = {value}  (Deadzone)
rest_suggestion_fuzz     = {value}  (Fuzz)
range_col_axis       = Achse
range_col_min        = Erreicht min
range_col_max        = Erreicht max
range_col_kernel     = Kernel-Bereich
range_col_coverage   = Abdeckung
range_col_verdict    = Bewertung
range_verdict_full   = voller Ausschlag
range_verdict_ok     = knapp, aber brauchbar
range_verdict_low    = erreicht die Anschläge nicht
range_verdict_bad    = kaum bewegt oder defekt

[output]
status_available     = Ausgabe geht über {binary}. Läuft der Daemon x52d, sollte hier dessen Client stehen – zwei Prozesse gleichzeitig auf MFD und LEDs verträgt das Gerät nicht.
status_unavailable   = Kein libx52-CLI gefunden. LEDs und MFD des X52 Pro laufen nicht über evdev, sondern über USB-Control-Transfers – dafür wird libx52 gebraucht. Unten „Programm suchen" oder den Pfad eintragen.
group_leds           = LEDs
btn_sweep            = Alle LEDs durchtesten
btn_all_on           = Alle an
btn_all_off          = Alle aus
label_brightness     = Helligkeit
group_mfd            = MFD ({lines} Zeilen zu {width} Zeichen)
mfd_row_label        = Zeile {line}
btn_mfd_test         = Testmuster senden
btn_mfd_clear        = MFD leeren
group_clutch         = Clutch (Taste 31, aufgedrucktes Symbol: ein „i" im Kreis)
clutch_explain       = Ist der Kupplungsmodus am Gerät aktiv, liest der Kernel-Treiber (usbhid) diese Taste nicht als normalen Joystick-Button ein – sie bleibt im Live-Test unsichtbar, obwohl sie physisch gedrückt wird. Hier lässt sich der Modus abschalten, sofern das installierte libx52 das unterstützt.
clutch_checkbox      = Kupplungsmodus aktiv
group_backend        = Aufruf des libx52-CLI
backend_label_binary = Programm
backend_label_led    = LED
backend_label_mfd    = MFD
backend_label_bri    = Helligkeit
backend_label_clutch = Clutch
backend_hint         = Platzhalter: {bin} {led} {state} {line} {text} {target} {value}. Die Vorlage wird erst in Tokens zerlegt, dann eingesetzt – MFD-Text mit Leerzeichen bleibt also ein Argument.
btn_detect           = Programm suchen
btn_save_backend     = Übernehmen und speichern
group_log            = Protokoll
log_settings_saved   = Einstellungen gespeichert in {path}
log_no_binary        = Kein x52ctl oder x52cli im PATH. libx52 installieren (PPA, AUR oder aus dem Quelltext).
log_summary          = -- {count} Befehle, {failures} fehlgeschlagen
led_fire             = Fire (Abdeckung)
led_a                = Taste A
led_b                = Taste B
led_d                = Taste D
led_e                = Taste E
led_t1               = Kippschalter T1/T2
led_t2               = Kippschalter T3/T4
led_t3               = Kippschalter T5/T6
led_pov              = POV-Hat 2
led_clutch           = Clutch (i-Taste)
led_throttle         = Schubhebel

[settings]
tab_label            = Einstellungen
group_language       = Sprache
btn_de               = Deutsch
btn_en               = Englisch
